# Copy to .env for local/offline development. NEVER commit the real .env file.
# .env is git-ignored on purpose -- this is the "secure local secret storage" mechanism
# for offline mode. In AWS, the equivalent values are pulled from Secrets Manager /
# SSM Parameter Store by the SecretsProvider abstraction (see backend/src/secrets).

# Which environment's config layer is active (local|beta|prod). This also picks
# the active LLM provider via config/data/<env>.json's "llm.provider" key (with
# */*/* wildcard fallback) -- see backend/src/config/ConfigResolver.ts. It is
# NOT read directly by LLMProviderFactory; only the JSON config layer decides
# openai vs anthropic vs ollama vs test-stub.
APP_ENV=local

# --- Database (offline Postgres via docker-compose) ---
DATABASE_URL=postgresql://scaler:scaler_local_pw@localhost:5432/scaler

# --- Auth (local mode uses signed JWTs instead of Cognito) ---
JWT_SECRET=change-me-in-local-env-only
JWT_EXPIRY=8h

# --- LLM secrets. Which of these is actually used depends on the active
# config's "llm.provider" (see APP_ENV note above; local.json defaults to
# "anthropic"). Never logged, never checked in -- loaded at call time via
# ISecretsProvider, not read directly by application code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only needed when LLM_PROVIDER=ollama (docker-compose runs an ollama service)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Rate limiting (demo defaults: 10 requests / 10 minutes) ---
RATE_LIMIT_TICKET_CREATE_MAX=10
RATE_LIMIT_TICKET_CREATE_WINDOW_MS=600000
RATE_LIMIT_SUMMARISE_MAX=10
RATE_LIMIT_SUMMARISE_WINDOW_MS=600000

# --- S3 (offline uses a local fake, e.g. a filesystem-backed stub; AWS uses real S3) ---
DOCS_STORAGE_MODE=local-fs
DOCS_LOCAL_PATH=./.data/attachments

PORT=4000
AWS_REGION=us-east-1
